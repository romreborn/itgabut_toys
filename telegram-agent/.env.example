# ---- Copy this file to ".env" and fill it in. Never commit ".env". ----

# Bot token from @BotFather (keep secret; rotate if it leaks).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram USER ids allowed to command the agent.
# Message the bot with /id to get yours. ONLY these ids can run anything.
# Keep this to yourself only — subscription auth is not allowed for other users.
ALLOWED_TELEGRAM_IDS=

# Claude SUBSCRIPTION token from `claude setup-token` (NOT an API key).
CLAUDE_CODE_OAUTH_TOKEN=

# Absolute path to the project the agent works in.
# Use forward slashes OR double backslashes on Windows:
PROJECT_DIR=E:/deploy/website/website

# OPTIONAL (Windows only): path to Git Bash, if the agent's bash tool can't find it.
# CLAUDE_CODE_GIT_BASH_PATH=C:/Program Files/Git/bin/bash.exe

# Do NOT set ANTHROPIC_API_KEY anywhere for this process. If it is set, it overrides
# the subscription token and you get billed per token. The bot strips it at startup
# as a safety net, but keep it unset in the service environment too.
