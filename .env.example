# Copy to .env.local for local dev. On Vercel, set these as Project
# Environment Variables (Settings > Environment Variables) — same values.
#
# Public Supabase credentials — safe to expose client-side (NEXT_PUBLIC_*
# vars are bundled into the browser build). Access is restricted by Row
# Level Security: only active products and published blog posts are
# readable via this key; orders/customers/admin_users stay locked.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
