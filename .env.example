# Copy to .env.local for local dev. On Vercel, set these as Project
# Environment Variables (Settings > Environment Variables) — same values.
#
# Public Supabase credentials — safe to expose client-side (NEXT_PUBLIC_*
# vars are bundled into the browser build). Access is restricted by Row
# Level Security: only active products and published blog posts are
# readable via this key; orders/customers/admin_users stay locked.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Server-only — never exposed to the browser. Powers the /admin panel
# (Project Settings > API > service_role). Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"

# Signs the /admin login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_SESSION_SECRET="<random-secret>"
